{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nebula Reader",
  "version": "1.0.0",
  "identifier": "com.nebulareader.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nebula Reader",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        },
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://nebula.localhost nebula:; style-src 'self' 'unsafe-inline' http://nebula.localhost nebula:; font-src 'self' data: http://nebula.localhost nebula:; script-src 'self'; connect-src ipc: http://ipc.localhost http://nebula.localhost nebula:",
      "devCsp": "default-src 'self'; img-src 'self' data: http://nebula.localhost nebula:; style-src 'self' 'unsafe-inline' http://nebula.localhost nebula:; font-src 'self' data: http://nebula.localhost nebula:; script-src 'self'; connect-src ipc: http://ipc.localhost http://nebula.localhost nebula: ws://localhost:1420 ws://127.0.0.1:1420 http://127.0.0.1:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/pdfium/pdfium.dll": "pdfium/pdfium.dll",
      "resources/pdfium/LICENSE": "pdfium/LICENSE",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "publisher": "Roxvs",
    "copyright": "© 2026 Roxvs. Licencia MIT.",
    "homepage": "https://github.com/imroxvs-lab/nebula-reader",
    "category": "Productivity",
    "shortDescription": "Lector de libros y cómics",
    "longDescription": "Lector de libros (EPUB, PDF) y cómics (CBZ, CBR, CB7) para Windows 11.",
    "licenseFile": "../LICENSE",
    "fileAssociations": [
      {
        "ext": [
          "cbz",
          "cbr",
          "cb7"
        ],
        "name": "NebulaReader.Comic",
        "description": "Cómic",
        "role": "Viewer"
      },
      {
        "ext": [
          "epub"
        ],
        "name": "NebulaReader.Epub",
        "description": "Libro electrónico EPUB",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Nebula Reader",
        "compression": "lzma",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
